{
  "name": "hunt-maps",
  "version": "0.1.0",
  "private": true,
  "description": "Ridgeline — a self-hosted hunting map & terrain-analytics platform. Deep LiDAR/topo analysis, offline-first PWA.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Overcastly-AI/hunt-maps.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "pnpm --filter @hunt-maps/api prisma migrate dev",
    "db:seed": "pnpm --filter @hunt-maps/api db:seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
