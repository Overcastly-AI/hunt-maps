node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo

.env
.env.local
.env.*.local

# Map/terrain data caches — never commit tiles or DEMs
data/
tiles/
*.pmtiles
*.mbtiles
*.tif
*.tiff
*.laz
*.las

# ...except the committed test fixtures. These are deliberately small slices of
# real USGS 3DEP products, kept verbatim so the GeoTIFF decoder is tested
# against bytes GDAL actually wrote rather than against our own encoder. The
# blanket *.tif rule above silently excluded them once, which left a committed
# test reading a file that was not in the repo.
!packages/terrain/src/testing/fixtures/*.tif

# Test artifacts
playwright-report/
test-results/
.playwright/

.DS_Store
*.log

# Agent scratch harnesses — measurement scripts written mid-task, never deliverables
**/__scratch*
**/__bench*
