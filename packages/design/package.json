{
  "name": "@hunt-maps/design",
  "version": "0.1.0",
  "private": true,
  "description": "Ridgeline design system \u2014 tokens, primitives and styles. Decoupled from any app so UI changes land in one place.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/styles.css",
    "src/fonts.css"
  ],
  "scripts": {
    "build:tokens": "tsx scripts/build-tokens.ts",
    "build": "pnpm build:tokens && tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
