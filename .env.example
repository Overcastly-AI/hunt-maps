# Copy to `.env` and fill in: `cp .env.example .env`
# docker compose reads it automatically. `.env` is gitignored — keep it that way.
#
# This file serves both local workflows:
#   - `docker compose up -d --build`, which runs everything in containers
#   - `pnpm dev`, which runs the API and web dev server on your host against
#     the Dockerised Postgres
# The two need different values in places; where that matters it is called out.

# --- Required ---------------------------------------------------------------

# `docker compose up` refuses to start without this, and the API refuses to
# boot without it. A weak default is how "anyone can mint a token for any
# account" reaches production.
#   openssl rand -base64 48
JWT_SECRET=

# --- Database ---------------------------------------------------------------

POSTGRES_USER=ridgeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ridgeline

# For `pnpm dev` only — the API running on your host, talking to the Postgres
# container through its published port. Inside docker compose the API builds
# its own URL against the `db` service name and ignores this.
DATABASE_URL=postgresql://ridgeline:change-me@localhost:5432/ridgeline

# --- Ports ------------------------------------------------------------------

DB_PORT=5432
API_PORT=3001
WEB_PORT=8080

# --- Origins ----------------------------------------------------------------

# Every origin a browser loads the app from. 5173 is the Vite dev server used
# by `pnpm dev`; 8080 is the containerised web service. Both are listed so
# switching between the two workflows does not silently break every API call
# with a CORS error.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Optional ---------------------------------------------------------------

# USGS 3DEP (1m LiDAR) tiles for the API. Empty means the API serves public
# Terrarium tiles and rejects `3dep` requests with a clear message rather than
# silently falling back to coarser data.
# DEM_3DEP_TEMPLATE=

# Elevation source for the browser. Build-time only — Vite inlines it, so
# changing it needs `docker compose build`, not a restart.
# VITE_DEM_TEMPLATE=
