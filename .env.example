# Copy to .env and fill in. `docker compose up` refuses to start without
# JWT_SECRET — a weak default is how "anyone can mint a token for any account"
# reaches production.

# Generate with: openssl rand -base64 48
JWT_SECRET=

POSTGRES_USER=ridgeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ridgeline
DATABASE_URL=postgresql://ridgeline:change-me@localhost:5432/ridgeline

REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: USGS 3DEP bare-earth LiDAR tiles (needs an OpenTopography key).
# Leave blank to use the free global AWS Terrain Tiles surface model.
# Bare earth matters under timber — a surface model describes the canopy, not
# the ground the deer walk on.
DEM_3DEP_TEMPLATE=

# Front end
VITE_API_URL=http://localhost:3001
VITE_DEM_TEMPLATE=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
