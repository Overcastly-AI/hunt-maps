# Copy to `.env` beside the compose files. `docker compose` reads it automatically.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Do not commit the result. `.env` is gitignored; `.env.example` is the one
# that belongs in the repo.

# --- Required -----------------------------------------------------------------

# The API refuses to boot without this rather than shipping a weak default.
#   openssl rand -base64 48
JWT_SECRET=

# Set once, before the database volume is first created. Postgres burns the
# password into the data directory at initialisation and never re-reads this,
# so changing it later does NOT change the database password — it only breaks
# the API's ability to connect. To rotate, ALTER USER inside the running
# container and update this to match.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Every origin a browser will load the app from, comma-separated. Must match
# the address you actually visit, including scheme and any non-default port,
# or the browser blocks the API calls.
CORS_ORIGINS=https://ridgeline.example.com

# --- Optional -----------------------------------------------------------------

# Image tag to run. Pin a v* release or a sha-<commit> in production; `latest`
# moving under a running host is how two containers end up on different builds.
RIDGELINE_TAG=latest

# Host port the web container publishes. Behind a reverse proxy, 127.0.0.1
# binding is better still — see README.md.
WEB_PORT=8080

POSTGRES_USER=ridgeline
POSTGRES_DB=ridgeline

# USGS 3DEP (1m LiDAR) tile template for the API. Left empty, the API serves
# public Terrarium tiles and rejects `3dep` requests with a clear message
# rather than silently falling back to coarser data.
DEM_3DEP_TEMPLATE=

# Elevation source for the *browser*. Build-time only — it is compiled into
# the JavaScript bundle, so it only takes effect with docker-compose.build.yml
# and a rebuild. Empty means public AWS Terrarium tiles.
VITE_DEM_TEMPLATE=

# --- Unattended updates (only read with `--profile autoupdate`) ---------------
#
# These do nothing unless you start the optional Watchtower service:
#   docker compose --profile autoupdate up -d
# Read the tradeoffs in README.md first — an unattended restart mid-hunt is a
# real cost, and auto-update only works on a MOVING tag, so it is mutually
# exclusive with pinning RIDGELINE_TAG above.

# Your timezone. Without it the schedule below runs in UTC and "13:00" is not
# your midday — which is the entire point of the default.
#   America/Chicago, Europe/London, …
TZ=UTC

# Six-field cron (seconds first). Default: 13:00 daily — the middle of the day,
# between the morning sit and the evening sit. Never set this to a time that
# can fire at first light.
WATCHTOWER_SCHEDULE=0 0 13 * * *

# Where the host's registry credentials live, mounted read-only so Watchtower
# can pull private GHCR packages. Only needed if the packages are private.
DOCKER_CONFIG_DIR=/root/.docker

# Optional shoutrrr URL for update notifications (e.g. an ntfy or Slack URL).
# Empty means updates happen silently, which is worth avoiding: the whole risk
# of this profile is a restart nobody knew about.
WATCHTOWER_NOTIFICATION_URL=
